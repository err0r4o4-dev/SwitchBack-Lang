<Window x:Class="SwitchBack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchBack Settings"
        Width="520"
        Height="570"
        MinWidth="480"
        MinHeight="520"
        Background="#070809"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI"
        Icon="Assets/SwitchBack.ico"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#101216" />
            <Setter Property="BorderBrush" Value="#252830" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#181B21" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#343842" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7" />
        </Style>
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#E4E7EC" />
            <Setter Property="Foreground" Value="#090A0C" />
            <Setter Property="BorderBrush" Value="#F4F5F7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,22,26,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="10" BorderBrush="#2B2E35" BorderThickness="1">
                <Border.Background>
                    <ImageBrush ImageSource="Assets/SwitchBack-Logo.png"
                                Viewbox="0.20,0.17,0.60,0.60"
                                ViewboxUnits="RelativeToBoundingBox"
                                Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="SwitchBack" />
                <TextBlock x:Name="SubtitleTextBlock" Margin="0,2,0,0" Foreground="#9A9CA3" />
            </StackPanel>
            <CheckBox x:Name="EnabledCheckBox" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,0,26,16">
                <TextBlock x:Name="UsageHintTextBlock" Margin="2,0,2,14" Foreground="#A1A1AA" TextWrapping="Wrap" />

                <Border Style="{StaticResource SectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ShortcutLabel" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <CheckBox x:Name="ControlCheckBox" Margin="0,7,10,7" Content="Ctrl" />
                            <CheckBox x:Name="ShiftCheckBox" Margin="0,7,10,7" Content="Shift" />
                            <CheckBox x:Name="AltCheckBox" Margin="0,7,10,7" Content="Alt" />
                            <CheckBox x:Name="WindowsCheckBox" Margin="0,7,10,7" Content="Win" />
                            <ComboBox x:Name="HotkeyComboBox" Width="92" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InterfaceLanguageLabel" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox x:Name="UiLanguageComboBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <Expander x:Name="AdvancedExpander" Margin="2,4,2,0" Foreground="#D4D4D8">
                    <Border Margin="0,10,0,0" Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="MixedTextLabel" Margin="0,0,0,5" Foreground="#B4B5BA" />
                            <ComboBox x:Name="MixedTextPolicyComboBox" Margin="0,0,0,12" />

                            <CheckBox x:Name="RestoreClipboardCheckBox" Margin="0,5" />
                            <CheckBox x:Name="StartWithWindowsCheckBox" Margin="0,5" />
                            <CheckBox x:Name="NotificationsCheckBox" Margin="0,5" />

                            <ComboBox x:Name="ConversionModeComboBox" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Expander>

                <TextBlock Margin="2,16,2,0" Foreground="#777A82" FontSize="11.5" TextWrapping="Wrap">
                    <Run x:Name="PrivacyTitleRun" FontWeight="SemiBold" />
                    <Run x:Name="PrivacyRun" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="26,13" Background="#0C0E11" BorderBrush="#252830" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusTextBlock" Margin="0,0,130,0" VerticalAlignment="Center" Foreground="#F87171" TextWrapping="Wrap" />
                <Button x:Name="SaveButton"
                        HorizontalAlignment="Right"
                        Click="SaveButton_Click"
                        IsDefault="True"
                        Style="{StaticResource SaveButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
