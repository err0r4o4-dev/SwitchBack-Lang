<Window x:Class="SwitchBack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchBack Settings"
        Width="620"
        Height="650"
        MinWidth="540"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="SwitchBack" />
                <TextBlock Margin="0,4,0,18"
                           Foreground="#666666"
                           Text="Fix text typed with the wrong Thai/English keyboard layout." />
            </StackPanel>

            <GroupBox Grid.Row="1" Header="Status" Margin="0,0,0,14" Padding="14">
                <StackPanel>
                    <CheckBox x:Name="EnabledCheckBox" Content="Enable global text conversion" />
                    <TextBlock Foreground="#666666" TextWrapping="Wrap"
                               Text="Select text in any application, then press the hotkey. SwitchBack copies, converts, and pastes it back." />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Conversion" Margin="0,0,0,14" Padding="14">
                <StackPanel>
                    <TextBlock Margin="0,0,0,6" Text="Direction" />
                    <ComboBox x:Name="ConversionModeComboBox" MinWidth="220" HorizontalAlignment="Left" />
                    <CheckBox x:Name="RestoreClipboardCheckBox"
                              Content="Restore the previous Clipboard after conversion (recommended)" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Global hotkey" Margin="0,0,0,14" Padding="14">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="ControlCheckBox" Margin="0,7,16,7" Content="Ctrl" />
                        <CheckBox x:Name="ShiftCheckBox" Margin="0,7,16,7" Content="Shift" />
                        <CheckBox x:Name="AltCheckBox" Margin="0,7,16,7" Content="Alt" />
                        <CheckBox x:Name="WindowsCheckBox" Margin="0,7,16,7" Content="Win" />
                        <ComboBox x:Name="HotkeyComboBox" Width="120" Margin="0,2" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0" Foreground="#666666" TextWrapping="Wrap"
                               Text="Default: Ctrl + Shift + Space. If another application uses the same shortcut, SwitchBack will ask you to choose a different one." />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="Windows" Margin="0,0,0,14" Padding="14">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start SwitchBack with Windows" />
                    <CheckBox x:Name="NotificationsCheckBox" Content="Show a notification after conversion" />
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Row="5">
                <Border Padding="12" Margin="0,0,0,12" Background="#EEF6FF" CornerRadius="4">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Privacy: " />
                        <Run Text="SwitchBack works 100% offline. Selected text is processed in memory and is never sent to a server. Conversion history is not stored in this MVP." />
                    </TextBlock>
                </Border>
                <TextBlock x:Name="StatusTextBlock" Margin="4" Foreground="#B00020" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="HideButton_Click" Content="Hide to tray" />
                    <Button Click="SaveButton_Click" Content="Save settings" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
