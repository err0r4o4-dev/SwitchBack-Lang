<Window x:Class="SwitchBack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchBack Settings"
        Width="680"
        Height="820"
        MinWidth="580"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="SwitchBack" />
            <TextBlock x:Name="SubtitleTextBlock" Margin="0,4,0,18" Foreground="#666666" />

            <GroupBox x:Name="InterfaceLanguageGroup" Margin="0,0,0,14" Padding="14">
                <ComboBox x:Name="UiLanguageComboBox" Width="260" HorizontalAlignment="Left" />
            </GroupBox>

            <GroupBox x:Name="StatusGroup" Margin="0,0,0,14" Padding="14">
                <StackPanel>
                    <CheckBox x:Name="EnabledCheckBox" />
                    <TextBlock x:Name="UsageHintTextBlock" Foreground="#666666" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ConversionGroup" Margin="0,0,0,14" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DirectionLabel" Grid.Row="0" Margin="0,8" />
                    <ComboBox x:Name="ConversionModeComboBox" Grid.Row="0" Grid.Column="1" Margin="0,3" />

                    <TextBlock x:Name="LayoutALabel" Grid.Row="1" Margin="0,8" />
                    <ComboBox x:Name="LayoutAComboBox" Grid.Row="1" Grid.Column="1" Margin="0,3" />

                    <TextBlock x:Name="LayoutBLabel" Grid.Row="2" Margin="0,8" />
                    <ComboBox x:Name="LayoutBComboBox" Grid.Row="2" Grid.Column="1" Margin="0,3" />

                    <TextBlock x:Name="MixedTextLabel" Grid.Row="3" Margin="0,8" />
                    <ComboBox x:Name="MixedTextPolicyComboBox" Grid.Row="3" Grid.Column="1" Margin="0,3" />

                    <CheckBox x:Name="RestoreClipboardCheckBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" />
                </Grid>
            </GroupBox>

            <GroupBox x:Name="GlobalHotkeyGroup" Margin="0,0,0,14" Padding="14">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="ControlCheckBox" Margin="0,7,16,7" Content="Ctrl" />
                        <CheckBox x:Name="ShiftCheckBox" Margin="0,7,16,7" Content="Shift" />
                        <CheckBox x:Name="AltCheckBox" Margin="0,7,16,7" Content="Alt" />
                        <CheckBox x:Name="WindowsCheckBox" Margin="0,7,16,7" Content="Win" />
                        <ComboBox x:Name="HotkeyComboBox" Width="120" Margin="0,2" />
                    </WrapPanel>
                    <TextBlock x:Name="HotkeyHintTextBlock" Margin="0,8,0,0" Foreground="#666666" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="WindowsGroup" Margin="0,0,0,14" Padding="14">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox" />
                    <CheckBox x:Name="NotificationsCheckBox" />
                </StackPanel>
            </GroupBox>

            <Border Padding="12" Margin="0,0,0,12" Background="#EEF6FF" CornerRadius="4">
                <TextBlock TextWrapping="Wrap">
                    <Run x:Name="PrivacyTitleRun" FontWeight="SemiBold" />
                    <Run x:Name="PrivacyRun" />
                </TextBlock>
            </Border>

            <TextBlock x:Name="StatusTextBlock" Margin="4" Foreground="#B00020" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="HideButton" Click="HideButton_Click" />
                <Button x:Name="SaveButton" Click="SaveButton_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
